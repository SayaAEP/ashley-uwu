# ─── Ashley UwU — Environment Overrides ────────────────────────────
#
# Copy this file to `.env` and fill in ONLY the values you want to change.
#   Windows : copy .env.example .env
#   Linux   : cp .env.example .env
#
# `.env` is git-ignored, so your local paths and secrets stay private.
# This `.env.example` file IS committed — keep its values empty.
#
# HOW IT WORKS
#   .env value   →  wins over
#   config.js    →  wins over
#   auto-detect (browser-bin/ folder, then system install)
#
# That means you can deploy a fork with nothing but a `.env` file and never
# edit config.js — so `git pull` of upstream updates never conflicts.
#
# Real environment variables (Docker, systemd, CI, your host panel) win over
# `.env` as well, so you can override anything without a file at all.
#
# RULES
#   • Leave a value EMPTY to keep the config.js default.
#   • Quote values that contain spaces, # or :  KEY="my value"
#   • Numbers: COOLDOWN_MS=5000
#   • Booleans: true / false / 1 / 0 / yes / no / on / off
#   • Arrays:   PUPPETEER_ARGS=--no-sandbox,--disable-gpu
#               or     PUPPETEER_ARGS="[\"--no-sandbox\",\"--disable-gpu\"]"


# ─── Identity ───────────────────────────────────────────────────
# Display name of the bot.
BOT_NAME=
# Version string shown on startup.
BOT_VERSION=
# Name of the sticker pack.
STICKER_NAME=

# ─── Command Prefixes ───────────────────────────────────────────
# Main command prefix.
PREFIX=
# Alternative prefix.
SECOND_PREFIX=

# ─── Owner ──────────────────────────────────────────────────────
# Your WhatsApp number in the format <country_code><number>@c.us
# Example: 6281234567890@c.us
OWNER_NUMBER=

# ─── Auth Strategy ──────────────────────────────────────────────
# Options: local | remote | none
#   local  - session saved to disk (.wwebjs_auth/)
#   remote - session saved to MongoDB (needs wwebjs-mongo + mongoose)
#   none   - no session persistence, QR scan every restart
AUTH_STRATEGY=
# Folder where the LocalAuth session is stored.
AUTH_DATA_PATH=

# ─── Chromium / Chrome ──────────────────────────────────────────
# Path to a Chromium/Chrome executable.
#
# This bot uses puppeteer-core, which does NOT ship a browser — a path is
# required. If left empty, the bot searches browser-bin/ and then your
# system, then saves what it finds back into this file.
#
# Windows : E:/ungoogled-chromium-portable-win64-140.0.7339.137-21/app/chrome.exe
# Linux   : /usr/bin/chromium
# macOS   : /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
#
# Use forward slashes — "\u" in a Windows path is an invalid JS escape.
PUPPETEER_EXECUTABLE_PATH=

# ─── Puppeteer Tuning ───────────────────────────────────────────
# Cache WhatsApp Web version files locally (saves bandwidth on slow links).
USE_WEB_VERSION_CACHE=
# Chromium command line flags, comma separated.
# Leave empty to use the low-RAM tuned defaults from config.js.
PUPPETEER_ARGS=
# Timeout for Chromium DevTools Protocol commands (ms). 0 disables the timeout.
PUPPETEER_PROTOCOL_TIMEOUT=
# Timeout for the WhatsApp Web authentication process (ms). 0 disables it.
AUTH_TIMEOUT_MS=

# ─── FFmpeg ─────────────────────────────────────────────────────
# Path to the FFmpeg executable. Auto-detected on first run if left empty.
FFMPEG_PATH=

# ─── MongoDB (RemoteAuth only) ──────────────────────────────────
# Connection string, e.g. mongodb://localhost:27017/ashley-uwu
# Quote it if it contains # or spaces.
MONGO_URI=
# How often RemoteAuth backs up the session to MongoDB (ms, min 60000).
BACKUP_SYNC_INTERVAL_MS=
# Max time to wait for the session upload on shutdown (ms).
SHUTDOWN_SAVE_TIMEOUT_MS=

# ─── Runtime ────────────────────────────────────────────────────
# Print full error stack traces.
DEBUG=
# Delay between commands per user (ms).
COOLDOWN_MS=
