# ─── Ashley UwU — Environment Overrides ────────────────────────────
#
# Copy this file to `.env` and fill in ONLY the values you want to change.
#   Windows : copy .env.example .env
#   Linux   : cp .env.example .env
#
# `.env` is git-ignored, so your local paths and secrets stay private.
# This `.env.example` file IS committed — keep its values empty.
#
# HOW IT WORKS
#   .env value   →  wins over
#   config.js    →  wins over
#   auto-detect (browser-bin/ folder, then system install)
#
# That means you can deploy a fork with nothing but a `.env` file and never
# edit config.js — so `git pull` of upstream updates never conflicts.
#
# Real environment variables (Docker, systemd, CI, your host panel) win over
# `.env` as well, so you can override anything without a file at all.
#
# RULES
#   • Leave a value EMPTY to keep the config.js default.
#   • Quote values that contain spaces, # or :  KEY="my value"
#   • Numbers: COOLDOWN_MS=5000
#   • Booleans: true / false / 1 / 0 / yes / no / on / off
#   • Arrays:   BROWSER_CHROMIUM_ARGS=--no-sandbox,--disable-gpu
#               or     BROWSER_CHROMIUM_ARGS="[\"--no-sandbox\",\"--disable-gpu\"]"


# ─── Identity ───────────────────────────────────────────────────
# Display name of the bot.
BOT_NAME=
# Version string shown on startup.
# Defaults to the version in package.json — set this only to override it.
BOT_VERSION=
# Name of the sticker pack.
STICKER_NAME=

# ─── Command Prefixes ───────────────────────────────────────────
# Main command prefix.
PREFIX=
# Alternative prefix.
SECOND_PREFIX=

# ─── Owner ──────────────────────────────────────────────────────
# Your WhatsApp number in the format <country_code><number>@c.us
# Example: 6281234567890@c.us
OWNER_NUMBER=

# ─── Auth Strategy ──────────────────────────────────────────────
# Options: local | remote | none
#   local  - session saved to disk (.wwebjs_auth/)
#   remote - session saved to MongoDB (needs wwebjs-mongo + mongoose)
#   none   - no session persistence, QR scan every restart
AUTH_STRATEGY=
# Folder where the LocalAuth session is stored.
AUTH_DATA_PATH=

# ─── Browser ────────────────────────────────────────────────────
# Engine: auto (default) | chromium | firefox
#
#   auto     → detect from the executable path. Anything not recognized as
#              Firefox-family is treated as Chromium, so Thorium, Natrium,
#              Edge, Brave, Vivaldi, Opera, etc. all work automatically.
#   chromium → force Chromium launch options.
#   firefox  → force Firefox launch options (EXPERIMENTAL, not supported by
#              whatsapp-web.js). On failure the bot falls back to Chromium.
BROWSER_ENGINE=

# Primary browser executable (Chromium or Firefox).
#
# This bot uses puppeteer-core, which does NOT ship a browser — a path is
# required unless auto-detection finds one. If left empty, the bot searches
# browser-bin/ and then your system, then saves what it finds back here.
#
# Windows : C:/Program Files/Mozilla Firefox/firefox.exe
# Windows : E:/ungoogled-chromium-portable/app/chrome.exe
# Linux   : /usr/bin/chromium
# macOS   : /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
#
# Use forward slashes — "\u" in a Windows path is an invalid JS escape.
BROWSER_EXECUTABLE_PATH=

# Secondary path, tried when the primary is missing or fails to start.
# Typical setup: Firefox primary + Chromium fallback.
BROWSER_FALLBACK_EXECUTABLE_PATH=

# ─── Browser Tuning ─────────────────────────────────────────────
# Cache WhatsApp Web version files locally (saves bandwidth on slow links).
USE_WEB_VERSION_CACHE=
# Chromium command line flags, comma separated.
# Leave empty to use the low-RAM tuned defaults from config.js.
BROWSER_CHROMIUM_ARGS=
# Firefox command line flags, comma separated. Empty by default.
# Chromium flags must NOT go here — Firefox does not understand them.
BROWSER_FIREFOX_ARGS=
# Puppeteer protocol timeout (ms). Applies to both engines.
# 0 disables the timeout.
BROWSER_PROTOCOL_TIMEOUT=
# Timeout for the WhatsApp Web authentication process (ms). 0 disables it.
AUTH_TIMEOUT_MS=

# ─── FFmpeg ─────────────────────────────────────────────────────
# Path to the FFmpeg executable. Auto-detected on first run if left empty.
FFMPEG_PATH=

# ─── MongoDB (RemoteAuth only) ──────────────────────────────────
# Connection string, e.g. mongodb://localhost:27017/ashley-uwu
# Quote it if it contains # or spaces.
MONGO_URI=
# How often RemoteAuth backs up the session to MongoDB (ms, min 60000).
BACKUP_SYNC_INTERVAL_MS=
# Max time to wait for the session upload on shutdown (ms).
SHUTDOWN_SAVE_TIMEOUT_MS=

# ─── Runtime ────────────────────────────────────────────────────
# Print full error stack traces.
DEBUG=
# Delay between commands per user (ms).
COOLDOWN_MS=

# ─── Reconnect ──────────────────────────────────────────────────
# After a disconnect the client is rebuilt instead of leaving a dead
# process behind. Delay doubles each attempt, capped at the max below.
# Base delay for the first attempt (ms).
RECONNECT_BASE_DELAY_MS=
# Upper bound for the backoff delay (ms).
RECONNECT_MAX_DELAY_MS=
# Stop after this many attempts. 0 = retry forever (recommended).
RECONNECT_MAX_ATTEMPTS=

# ─── Media processing ───────────────────────────────────────────
# Maximum simultaneous FFmpeg/sharp jobs. Lower is safer on low-RAM
# devices; higher handles bursts faster. Default: 2.
MEDIA_CONCURRENCY=

# ─── Meme text (.smeme) ─────────────────────────────────────────
# Path to a custom .ttf/.otf used for meme text. Leave empty to use
# assets/ttf/impact.ttf if present, otherwise the system Impact font.
SMEME_FONT_PATH=
